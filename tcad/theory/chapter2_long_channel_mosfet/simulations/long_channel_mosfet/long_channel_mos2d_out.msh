end_node_model

begin_node_model "Donors"
COMMAND node_model -device "mos2d" -region "bulk" -display_type "scalar" -name "Donors" -equation "(1 + DrainDoping + SourceDoping);"
end_node_model

begin_node_model "DrainDoping"
COMMAND node_model -device "mos2d" -region "bulk" -display_type "scalar" -name "DrainDoping" -equation "(1e+19 * 2.500000000000000e-01 * erfc(((-(x + (-7.500000000000001e-05))) * pow(9.999999999999999e-21,(-1)))) * erfc(((y + (-1.000000000000000e-05)) * pow(1.000000000000000e-10,(-1)))));"
