COMMAND node_model -device "mos2d" -region "bulk" -display_type "scalar" -name "Acceptors" -equation "(1e+15 + BodyDoping);"
end_node_model

begin_node_model "AtContactNode"
BUILTIN
end_node_model

begin_node_model "BodyDoping"
COMMAND node_model -device "mos2d" -region "bulk" -display_type "scalar" -name "BodyDoping" -equation "(1e+19 * 5.000000000000000e-01 * erfc(((-(y + (-1.000000000000000e-04))) * pow(1.000000000000000e-10,(-1)))));"
end_node_model

