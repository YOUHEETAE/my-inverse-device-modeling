end_node_model

begin_node_model "NSurfaceNormal_y"
DATAPARENT "SurfaceArea"
end_node_model

begin_node_model "NetDoping"
COMMAND node_model -device "mos2d" -region "bulk" -display_type "scalar" -name "NetDoping" -equation "(Donors - Acceptors);"
end_node_model

