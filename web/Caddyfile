{$SITE_DOMAIN:localhost} {
	# Access log to stdout (captured by `docker compose logs web`) — Caddy
	# terminates the real internet-facing connection itself, so it logs the
	# actual visitor IP directly (no X-Forwarded-For needed), unlike the
	# backend's own uvicorn access log, which only ever sees Caddy's internal
	# docker-network IP since Caddy is the one making the proxied request.
	# console format, with the noisy per-request fields (every request/response
	# header, TLS handshake details) stripped out — what's left per line is
	# the useful part: remote_ip, method, uri, status, size, duration.
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>headers delete
				request>tls delete
				resp_headers delete
			}
		}
	}

	# Top-level try_files/file_server directives run in Caddy's fixed
	# directive order regardless of where they're written in the file, which
	# put them ahead of the /api/* handle block below and swallowed every
	# /api/* request as a SPA route — hence both routes need to be inside
	# explicit handle blocks, matched top-to-bottom, first match wins.

	# Proxies to java_service over the internal Docker network (service name
	# "java_service", see docker-compose.yml). java_service is the only
	# public entry point to the API; it forwards to the FastAPI backend
	# itself, which is never reachable directly from outside. strip_prefix
	# drops /api, since the service's own routes aren't prefixed with it.
	#
	# reverse_proxy sets X-Forwarded-For automatically, which is what
	# java_service's RateLimitInterceptor reads to see the real visitor IP
	# instead of Caddy's internal container IP.
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy java_service:8080
	}

	# Serves the Vite build directly and handles client-side routing
	# (react-router-dom's BrowserRouter) — a hard refresh on e.g. /fields has
	# no matching file on disk, so fall back to index.html.
	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}
}
