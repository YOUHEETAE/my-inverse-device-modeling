    "initial_random_trials_per_curve_kind": 12,
    "xgboost_space": {
      "max_depth": [3, 5, 7],
      "learning_rate": [0.02, 0.03, 0.05],
      "subsample": [0.8, 1.0],
      "colsample_bytree": [0.8, 1.0],
      "min_child_weight": [1, 3, 5],
      "reg_lambda": [0.3, 1.0, 3.0],
      "reg_alpha": [0.0, 0.001, 0.01]
    },
    "n_estimators": 5000,
    "early_stopping_rounds": 150
  },
  "model_candidates": [
    "pca_xgboost",
    "residual_multi_output_mlp",
    "shared_encoder_separate_heads"
  ]
}
