{
  "seed": 42,
  "split": {
    "method": "device_level_stratified_greedy_v1",
    "train": 0.7,
    "validation": 0.15,
    "test": 0.15
  },
  "input_features": [
    "L",
    "T",
    "log10_B",
    "log10_SD",
    "log10_LDD",
    "fixed_bias"
  ],
  "current_preprocessing": {
    "physical_noise_floor_mA_per_um": 1e-10,
    "evaluation_log_floor_mA_per_um": 1e-10,
    "idvd": "force the Vd=0 boundary to zero",
    "idvg": "clip values below the physical noise floor"
  },
  "selected_targets": {
    "idvd": {
      "mode": "bias_separated",
      "Vg_1.5": {"mode": "signed_log", "current_scale_mA_per_um": 0.001},
      "Vg_3.0": {"mode": "asinh", "current_scale_mA_per_um": 0.001}
    },
    "idvg": {"mode": "signed_log", "current_scale_mA_per_um": 1e-10}
  },
  "target_scaler": "per_coordinate",
  "feature_engineering": {
    "idvd_mode": "physical_v1",
    "idvg_mode": "none",
    "derived_features": [
      "1/L",
      "1/T",
      "L/T",
      "log10_SD-log10_B",
      "log10_LDD-log10_B",
      "log10_SD-log10_LDD"
    ]
  },
  "tail_weighting": {
    "enabled": false,
    "scope": "IdVd Vg=1.5 V",
    "rule": "optional smooth weight from current amplitude, oxide thickness, bulk, SD, and LDD",
    "reason": "disabled by default because validation tail score was worse"
  },
  "modeling_domain": "full prepared design domain",
  "pca_xgboost_optimization": {
    "component_candidates": [4, 8, 12, 16],
