# The desktop app reads process environment variables directly. Never commit a
# real API key. Copying this file alone does not load it automatically.
GROQ_API_KEY=replace_with_a_new_key

# Optional overrides; these defaults are already built into the application.
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY_ENV=GROQ_API_KEY

# Backend only (backend/app/main.py). Comma-separated list of origins the
# FastAPI CORS middleware will allow. Defaults to the local dev web ports if
# unset — override with the deployed frontend's real origin(s) in production.
CORS_ALLOW_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# java_service's PostgreSQL (accounts + sessions). Used by both the db
# container and java_service in docker-compose.yml. The service refuses to
# start without a password rather than falling back to a default, so a
# missing value fails loudly instead of silently running on a known one.
POSTGRES_DB=semiscope
POSTGRES_USER=semiscope
POSTGRES_PASSWORD=replace_with_a_local_password

# Google sign-in (java_service). Create an OAuth client at
# console.cloud.google.com and register the redirect URI Spring uses:
# <origin>/login/oauth2/code/google
GOOGLE_CLIENT_ID=replace_with_your_client_id
GOOGLE_CLIENT_SECRET=replace_with_your_client_secret

# docker-compose.yml only (the web/Caddy service). The domain Caddy requests
# a real Let's Encrypt certificate for. Leave unset for local `docker compose
# up` testing — Caddy then defaults to "localhost" and issues its own
# locally-trusted cert instead of calling Let's Encrypt.
SITE_DOMAIN=yourdomain.example.com
