# The desktop app reads process environment variables directly. Never commit a
# real API key. Copying this file alone does not load it automatically.
GROQ_API_KEY=replace_with_a_new_key

# Optional overrides; these defaults are already built into the application.
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY_ENV=GROQ_API_KEY
